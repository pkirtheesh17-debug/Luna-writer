# Luna Writer Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# MongoDB Configuration
# You can use a local MongoDB instance: mongodb://localhost:27017
# Or a remote MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster.mongodb.net
# If MongoDB is not reachable, Luna Writer will automatically run in high-fidelity embedded mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=luna_writer

# AI Service Configuration (Optional)
# Leave empty to use the built-in Cambridge B1 heuristic analysis engine.
# Provide a key to enable real LLM evaluations:
GEMINI_API_KEY=
# Or OpenAI API key:
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=2097152  # 2MB
ALLOWED_EXTENSIONS=.txt,.md,.docx,.json
